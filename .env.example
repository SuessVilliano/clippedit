NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/oauth/kick/callback

# OpenAI-compatible endpoint used by Release Spy. If no key is set,
# Release Spy falls back to its built-in deterministic content engine.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini

# Official HighLevel channel watched first for fresh Release Radar uploads.
HIGHLEVEL_YOUTUBE_CHANNEL_ID=UCYZHLNfuWTIqIFZRcF_mHZQ
# Blog source is used to enrich the YouTube-triggered content package.
HIGHLEVEL_RELEASE_RADAR_URL=https://www.gohighlevel.com/blog/category/release-radar

CRON_SECRET=
OPUS_API_KEY=
TRADEHYBRID_TV_WEBHOOK_URL=

# ── Video Factory V1 ─────────────────────────────────────────────────────────
# Feature flag (on unless set to "false"). NEXT_PUBLIC_ variant is browser-safe.
VIDEO_FACTORY_ENABLED=true
NEXT_PUBLIC_VIDEO_FACTORY_ENABLED=true

# Provider selection. Content reuses the existing LLM_API_KEY/URL/MODEL above.
# Voice defaults to your own recorded voice over screen capture; TTS is fallback.
VOICE_PROVIDER=sv-engine        # sv-engine | openai
IMAGE_PROVIDER=openai           # openai | openart(skeleton) | sv-engine
VIDEO_PROVIDER=sv-engine        # sv-engine | higgsfield(skeleton)
RENDER_PROVIDER=sv-engine       # sv-engine(ffmpeg) | remotion(optional)

# Cloud fallbacks (used when the engine box is offline)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# Adapter skeletons — leave blank until each provider's API is confirmed
OPENART_API_KEY=
OPENART_API_URL=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=

# The sv-content-engine worker (VoxCPM voice, HeyGen avatar, ComfyUI/fal
# b-roll, ffmpeg render). Local-first — reach it via a tunnel/URL + shared token.
SV_ENGINE_URL=
SV_ENGINE_TOKEN=
